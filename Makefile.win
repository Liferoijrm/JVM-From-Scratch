CC            ?= gcc
CFLAGS        ?= -Wall -Wextra -std=c99 -mconsole -I $(SRC_DIR) -I $(SRC_DIR)/class_loader/loading -I $(SRC_DIR)/viewer -I $(SRC_DIR)/utils -I $(SRC_DIR)/runtime_data/method_area
DEBUG_FLAGS   ?= -g -fsanitize=address,undefined
SRC_DIR       := src
OBJ_DIR       := build
BIN_DIR       := bin
TARGET_NAME   := jvm
EXE_EXT       := .exe
FIX_PATH      = $(subst /,\,$1)

TARGET := $(BIN_DIR)/$(TARGET_NAME)$(EXE_EXT)

SRCS := $(shell dir /s /b $(SRC_DIR)\*.c)
OBJS := $(patsubst $(SRC_DIR)\%.c,$(OBJ_DIR)\%.o,$(SRCS))

.PHONY: all clean debug help

all: $(TARGET)

$(TARGET): $(OBJS) | $(BIN_DIR)
	@echo Linking...
	$(CC) $(CFLAGS) $(OBJS) -o $@ -lm
	@echo Build complete. Executable: $@

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c | $(OBJ_DIR)
	@if not exist "$(call FIX_PATH,$(dir $@))" mkdir "$(call FIX_PATH,$(dir $@))"
	@echo Compiling $<...
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJ_DIR):
	@if not exist "$(call FIX_PATH,$@)" mkdir "$(call FIX_PATH,$@)"

$(BIN_DIR):
	@if not exist "$(call FIX_PATH,$@)" mkdir "$(call FIX_PATH,$@)"

clean:
	@if exist "$(OBJ_DIR)" rmdir /s /q "$(OBJ_DIR)"
	@if exist "$(BIN_DIR)" rmdir /s /q "$(BIN_DIR)"
	@echo Clean complete.

debug: CFLAGS += $(DEBUG_FLAGS)
debug: clean all

help:
	@echo Targets:
	@echo   all    - Compile the project (default)
	@echo   clean  - Remove build artifacts
	@echo   debug  - Build with debug symbols and sanitizers
	@echo.
	@echo Usage:
	@echo   mingw32-make -f Makefile.win all
	@echo   mingw32-make -f Makefile.win clean
	@echo   mingw32-make -f Makefile.win debug